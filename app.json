{
  "expo": {
    "name": "timer",
    "slug": "timer",
    "scheme": "kaoyan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A211B",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kaoyan.studylibrary",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kaoyan.studylibrary",
      "adaptiveIcon": {
        "backgroundColor": "#1A211B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#8ED6A4",
          "defaultChannel": "study-timer"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A211B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5c454c3-8e2a-4eab-a13e-7c604bf1c64a"
      }
    }
  }
}
